# Autodesk Platform Services (APS) OAuth credentials.
# Register an app at https://aps.autodesk.com/myapps and copy the Client ID / Secret.
APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here

# Redirect URI registered on your APS app. For local dev this is typically:
APS_CALLBACK_URL=http://localhost:8080/auth/callback

# Any long random string. Used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Port for the Express server (defaults to 8080).
PORT=8080
